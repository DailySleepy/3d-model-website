# ==============================================================================
# 后端本地独立启动开发配置模板 (非容器)
#
# 使用指南:
# 1. 复制本文件并重命名为 `.env` (在 backend/ 目录下 cp .env.example .env)
# 2. 修改为本地实际安装的 PostgreSQL 数据库连接凭证
# 3. 运行 `mvn spring-boot:run` 启动后端服务
# ==============================================================================

# 本地数据库 URL (端口通常为 5432，提前通过 CREATE DATABASE threed_model_db 创建库)
DB_URL=localhost:5432/threed_model_db

# 本地数据库用户名
DB_USERNAME=postgres

# 本地数据库连接密码
DB_PASSWORD=your_local_postgres_password_here
