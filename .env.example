# ==============================================================================
# Docker Compose 部署环境变量模板
#
# 使用指南:
# 1. 复制本文件并重命名为 `.env` (cp .env.example .env)
# 2. 修改其中的数据库密码（POSTGRES_PASSWORD 和 DB_PASSWORD）
# 3. 运行 `docker-compose up -d` 启动服务
# ==============================================================================

# PostgreSQL 数据库配置
POSTGRES_DB=threed_model_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# 后端连接数据库配置 (DB_PASSWORD 必须与上方的 POSTGRES_PASSWORD 保持完全一致)
DB_URL=postgres:5432/threed_model_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
