# 数据库配置：默认连接本地 PostgreSQL。
DB_URL=127.0.0.1:5432/threed_model_db
DB_USERNAME=postgres
DB_PASSWORD=repalce-it

# 识图模型 API Key：Seedance。
IMAGE_API_KEY=replace-with-your-vision-model-key

# 对话模型 API Key：DeepSeek。
CHAT_API_KEY=replace-with-your-deepseek-key

# 嵌入模型 API Key：OpenRouter。
EMBEDDING_API_KEY=replace-with-your-openrouter-key
